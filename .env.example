# AI Push-Up Coach — environment variables
#
# Every variable in this file is OPTIONAL. With none of them set, the app runs
# entirely in the browser: pose estimation, rep counting, form scoring and
# session history all work locally, and nothing is uploaded.
#
# Usage: copy this file to apps/web/.env.local and fill in the values you want.
# Next.js loads .env.local from the app directory (apps/web), which is where
# `npm run dev` and `npm run build` execute. Do not commit .env.local.
#
# The names below are the only environment variables the application reads.
# Both are read in apps/web/lib/session-store.ts.


# ---------------------------------------------------------------------------
# Supabase session mirror — OPTIONAL
# ---------------------------------------------------------------------------
# When BOTH of the two variables below are set, finished workout sessions are
# additionally mirrored to Supabase so the leaderboard and progress pages can
# aggregate across devices. If either one is missing, the mirror is disabled
# and the app falls back to localStorage only. This is not an error state and
# the UI reports it as "local only".
#
# The mirror is written with plain fetch against the Supabase REST endpoint, so
# no Supabase SDK is required. The app stays a static build when unconfigured.
#
# Only numeric session summaries and per-rep scores are sent. Never video,
# never frames, never images.

# Your Supabase project URL, without a trailing slash.
# OPTIONAL — leave blank to keep the app local-only.
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase anon/public API key.
# OPTIONAL — required only if NEXT_PUBLIC_SUPABASE_URL is set.
# This is the public anon key, which is safe to expose in a browser bundle
# BECAUSE row-level security restricts it. Never put the service-role key here:
# NEXT_PUBLIC_ variables are embedded in client-side JavaScript and are visible
# to anyone who opens devtools.
# Find it in the Supabase dashboard under Project Settings -> API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - There is no API base URL variable. The optional server-side inference path
#   (apps/api) is not wired into the web app, and no code reads a base-URL
#   environment variable. The frontend works without any backend.
# - No other environment variable is read by the codebase. Anything else you
#   add here will be ignored.
# - Never commit real credentials. This file is a template containing obvious
#   placeholders only.
